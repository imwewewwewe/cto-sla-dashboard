{
  "family": "cto-sla-dashboard",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::226293104860:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::226293104860:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "cto-sla-dashboard",
      "image": "226293104860.dkr.ecr.eu-central-1.amazonaws.com/cto-sla-dashboard:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3001"
        },
        {
          "name": "AWS_REGION",
          "value": "eu-central-1"
        }
      ],
      "secrets": [
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:226293104860:secret:cto-sla/aws-access-key-id"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:226293104860:secret:cto-sla/aws-secret-access-key"
        },
        {
          "name": "MONGO_URI",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:226293104860:secret:cto-sla/mongo-uri"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/cto-sla-dashboard",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "app"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://localhost:3001/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})\""
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
